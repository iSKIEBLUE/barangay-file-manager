# ============================================================
# Barangay File Manager — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to Git!
# ============================================================

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=barangay_db

# --- JWT Secret (use a long random string in production) ---
SECRET_KEY=replace-this-with-a-very-long-random-secret-key

# --- Server port (Render/Azure injects $PORT automatically) ---
# PORT=8000
